{
  "name": "@ebarahona/loopback-transport-core",
  "version": "1.2.0",
  "description": "Transport-agnostic microservice primitives for LoopBack 4 — message handlers, event patterns, execution context, and client proxies for Kafka, RabbitMQ, gRPC, MQTT, and NATS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:dev": "vitest",
    "commitlint": "commitlint --edit",
    "prepare": "sh scripts/install-hooks.sh",
    "prepublishOnly": "npm run clean && npm run build",
    "bench": "node bench/index.mjs",
    "docs": "typedoc"
  },
  "keywords": [
    "loopback",
    "loopback4",
    "microservices",
    "transport",
    "kafka",
    "rabbitmq",
    "grpc",
    "mqtt",
    "nats",
    "event-driven",
    "message-handler",
    "execution-context",
    "loopback4 extension",
    "extension"
  ],
  "author": "Ed Barahona (https://github.com/ebarahona)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebarahona/loopback-transport-core.git"
  },
  "bugs": {
    "url": "https://github.com/ebarahona/loopback-transport-core/issues"
  },
  "homepage": "https://github.com/ebarahona/loopback-transport-core#readme",
  "peerDependencies": {
    "@loopback/core": ">=7.0.0 <8.0.0",
    "@loopback/metadata": ">=8.0.0 <9.0.0",
    "cloudevents": ">=10.0.0 <11.0.0",
    "rxjs": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@loopback/core": "^7.0.12",
    "@loopback/metadata": "^8.0.12",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cloudevents": ">=10.0.0 <11.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "lefthook": "^2.1.6",
    "prettier": "^3.2.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.0",
    "size-limit": "^11.0.0",
    "tinybench": "^3.1.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "dist (CommonJS)",
      "path": "dist/index.js",
      "limit": "100 KB",
      "ignore": [
        "@loopback/core",
        "@loopback/metadata",
        "cloudevents",
        "rxjs",
        "debug"
      ]
    }
  ]
}
