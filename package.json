{
  "name": "@ebarahona/loopback-transport-core",
  "version": "1.0.0",
  "description": "Unified transport abstraction for LoopBack 4. Message handlers, event patterns, execution context, and client proxies for Kafka, RabbitMQ, gRPC, MQTT, and NATS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:dev": "vitest",
    "prepublishOnly": "npm run clean && npm run lint && npm run build && npm test"
  },
  "keywords": [
    "loopback",
    "loopback4",
    "microservices",
    "transport",
    "kafka",
    "rabbitmq",
    "grpc",
    "mqtt",
    "nats",
    "event-driven",
    "message-handler",
    "execution-context"
  ],
  "author": "Ed Barahona (https://github.com/ebarahona)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ebarahona/loopback-transport-core.git"
  },
  "bugs": {
    "url": "https://github.com/ebarahona/loopback-transport-core/issues"
  },
  "homepage": "https://github.com/ebarahona/loopback-transport-core#readme",
  "peerDependencies": {
    "@loopback/core": ">=7.0.0",
    "@loopback/metadata": ">=8.0.0"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@loopback/core": "^7.0.12",
    "@loopback/metadata": "^8.0.12",
    "@loopback/rest": "^15.0.13",
    "@loopback/testlab": "^8.0.12",
    "@types/debug": "^4.1.12",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.2.2",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
